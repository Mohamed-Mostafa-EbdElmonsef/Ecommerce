@model ProductVM
<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">Create new Category</h2>
        </div>
    </div>

    <div class="row my-3" > 
        <div class="col-12">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <input class="form-control" name="Name" />
                </div>

                <div class="mb-3">
                    <label for="name" class="form-label">MainImg</label>
                    <input type="file" class="form-control" name="ImageFile" />
                </div>
                <div class="mb-3">
                    <label for="SubImageFiles" class="form-label">SubImages</label>
                    <input type="file" class="form-control" name="SubImageFiles" multiple />
                </div>
                <div class="mb-3">
                    <label for="Price" class="form-label">Price</label>
                    <input class="form-control" name="Price" />
                </div>
                <div class="mb-3">
                    <label for="Quantity" class="form-label">Quantity</label>
                    <input class="form-control" name="Quantity" />
                </div>
                <div class="mb-3">
                    <label for="Discount" class="form-label">Discount</label>
                    <input class="form-control" name="Discount" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <div class="form-floating">
                        <textarea class="form-control" placeholder="Leave a description here" style="height: 100px" name="Description"></textarea>
                        <label for="description">You Description Here...</label>

                    </div>
                </div>
                <div class="mb-3">
                    <label for="Color" class="form-label">Color</label>

                    <div id="colorContainer">
                        <div class="mb-2 d-flex align-item-center">
                            <input type="color" class="form-control form-control-color" name="Colors">
                        </div>
                    </div>

                    <button type="button" id="addButtonColor" class="btn btn-outline-primary">+ Add New Color</button>
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Category</label>
                    <select class="form-control" name="CategoryId">
                        <option>--Select Category--</option>
                        @foreach (var item in Model.Categories)
                        {
                            <option value="@item.Id">@item.Name</option>

                        }

                    </select>
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Brand</label>
                    <select class="form-control" name="CategoryId">
                        <option>--Select Brand--</option>
                        @foreach (var item in Model.Brands)
                        {
                            <option value="@item.Id">@item.Name</option>

                        }

                    </select>
                </div>
              

                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" name="Status">
                        <option value="True" selected>Active</option>
                        <option value="False">InActive</option>
                    </select>

                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>


<script>
    const conateiner = document.getElementById('colorContainer');
    const addBtn = document.getElementById('addButtonColor');

    addBtn.addEventListener('click', () => {
        var colorRow = document.createElement('div');

        colorRow.className = 'mb-2 d-flex align-item-center gap-1'
        colorRow.innerHTML = `
                <input type="color" class="form-control form-control-color" name="Colors">
                <button type="Button" class="btn btn-danger btn-sm removeColor">x</button>
            `;

        conateiner.appendChild(colorRow);
    });

    conateiner.addEventListener('click', (e) => {
        if (e.target.classList.contains('removeColor')) {
            e.target.parentElement.remove();
        }
    })
</script>

